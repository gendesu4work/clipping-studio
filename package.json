{
  "name": "creator-studio",
  "productName": "Creator Studio",
  "version": "1.0.2",
  "description": "Creator Studio desktop app (Electron shell around the local Python server)",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File electron/make-shortcut.ps1",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.2.1": true
  },
  "build": {
    "appId": "com.gendesu4work.creatorstudio",
    "productName": "Creator Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "studio",
        "filter": [
          "*.py",
          "static/**/*",
          "models/**/*",
          "backgrounds/counter.ffscript",
          "requirements.txt",
          "studio.ico",
          "README.md"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "studio.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Creator Studio",
      "artifactName": "Creator-Studio-Setup-${version}.exe"
    }
  }
}
